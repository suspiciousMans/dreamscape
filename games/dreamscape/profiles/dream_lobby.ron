(
    name: "dream_lobby",
    vertex_shader: "games/dreamscape/assets/shaders/mesh.vert",
    fragment_shader: "games/dreamscape/assets/shaders/mesh.frag",
    post_fragment_shader: "games/dreamscape/assets/shaders/post_composite.frag",
    render: (
        fixed_resolution: None,
        resolution_scale: 0.5,
        fog_color: (0.7, 0.7, 0.9),
        fog_start: 5.0,
        fog_end: 50.0,
        color_levels: 8,
        dither_strength: 0.3,
        lighting_mode: VertexLit,
        ambient_color: (0.4, 0.4, 0.5),
        light_dir: (1.0, 1.0, 1.0),
        vertex_snap_amount: 0.0,
        affine_texture_mapping: false,
        texture_filter: Nearest,
        backface_culling: true,
        sky_horizon_color: (0.5, 0.6, 0.8),
        sky_zenith_color: (0.2, 0.3, 0.6),
    ),
)
